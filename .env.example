# ==============================================================================
# UNIFIED TICKET TRACKER (PROJECT BEACON) - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Salin file ini menjadi '.env' dan isi kredensial yang sesuai.
# JANGAN PERNAH MENG-COMMIT FILE '.env' ASLI KE GITHUB!

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION (LOCAL / DOCKER)
# ------------------------------------------------------------------------------
PG_HOST="127.0.0.1"
PG_PORT=5432
PG_DATABASE="ticket_tracker"
PG_USER="dbuser"
PG_PASSWORD="your_strong_db_password"

# ------------------------------------------------------------------------------
# 2. EMAIL LISTENER (IMAP / TRITRONIK L2 SUPPORT)
# ------------------------------------------------------------------------------
EMAIL_HOST="rama.tritronik.com"
EMAIL_PORT=993
EMAIL_SECURE=true
EMAIL_USER="l2.support@tritronik.com"
EMAIL_PASS="your_email_password"
ENABLE_GMAIL_LISTENER=false

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT & NOTIFICATION CHANNELS
# ------------------------------------------------------------------------------
TG_TOKEN="your_bot_token"
TG_CHAT_ID="-1003753882093"
TG_BEACON_CHAT_ID="-1003753882093"
TG_UTT_CHAT_ID="-5546265953"
ALLOWED_TELEGRAM_GROUPS="-5546265953,-1003753882093,-5391596782"

# Telegram MTProto Userbot Client (Optional / Jika intake via personal TG)
TG_API_ID=
TG_API_HASH=
TG_PHONE_NUMBER=
TG_2FA_PASSWORD=
TG_SESSION_STRING=

# ------------------------------------------------------------------------------
# 4. WHATSAPP BOT (BAILEYS MULTI-DEVICE)
# ------------------------------------------------------------------------------
# Daftar JID grup WhatsApp yang dipantau (pisahkan dengan koma)
ALLOWED_WHATSAPP_GROUPS="120363428003150679@g.us,120363023573207018@g.us"

# ------------------------------------------------------------------------------
# 5. MICROSOFT TEAMS BOT & WEBHOOK
# ------------------------------------------------------------------------------
TEAMS_BOT_PORT=3978
TEAMS_WEBHOOK_URL="https://your_powerautomate_webhook_url"
MICROSOFT_APP_ID="your_microsoft_app_id"
MICROSOFT_APP_PASSWORD="your_microsoft_app_password"

# ------------------------------------------------------------------------------
# 6. AI & KNOWLEDGE BASE (OPENAI & OUTLINE CPD)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OUTLINE_BASE_URL="https://cpd.hutabyte.com"
OUTLINE_API_KEY="ol_api_..."
OUTLINE_COLLECTION_ID="bfc3f584-d33a-41c9-b7b0-cf00c88e619a"
OUTLINE_COLLECTION_NAME="PT Tricada Intronik"
OUTLINE_API_TIMEOUT_MS=15000
OUTLINE_API_MAX_RETRIES=2
OUTLINE_MAX_DOCUMENT_CHARS=12000
OUTLINE_MAX_TOTAL_CHARS=30000

# ------------------------------------------------------------------------------
# 7. THIRD-PARTY TICKETING (CLICKUP) & LEGACY OPTIONS
# ------------------------------------------------------------------------------
CLICKUP_API_KEY="pk_..."
CLICKUP_LIST_ID="901819032191"
USE_SUPABASE_AUTH=false
ENABLE_LEGACY_SUPABASE_RAG=true

